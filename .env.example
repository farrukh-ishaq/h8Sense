# Environment variables for h8Sense Application
# Copy this file to .env and update with your actual values

# ===========================================
# LLM Provider Selection
# ===========================================
# Choose: openai, ollama, or none (for mock/testing without API keys)
LLM_PROVIDER=none

# ===========================================
# OpenAI Configuration (if LLM_PROVIDER=openai)
# ===========================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3

# ===========================================
# Ollama Configuration (if LLM_PROVIDER=ollama)
# ===========================================
# For local Llama, Mistral, etc. via Ollama
# When running in Docker Compose, use 'http://ollama:11434'
# When running the Spring Boot app locally, use 'http://localhost:11434'
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TEMPERATURE=0.3

# ===========================================
# Database Configuration
# ===========================================
# When running in Docker Compose, use host 'postgres'
# When running locally, switch this to jdbc:postgresql://localhost:5432/islamophobia_detector
DATABASE_URL=jdbc:postgresql://postgres:5432/islamophobia_detector
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
JPA_DDL_AUTO=update
SHOW_SQL=false

# ===========================================
# Server Configuration
# ===========================================
SERVER_PORT=8080

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_FILE_PATH=/var/log/islamophobia-detector/app.log

# ===========================================
# Application Settings
# ===========================================
APP_CONTENT_FETCH_TIMEOUT=30
APP_CONTENT_MAX_LENGTH=50000
APP_CONTENT_FETCH_ENABLED=true
APP_CONTENT_BACKFILL_ENABLED=true
APP_SAMPLE_DATA_ENABLED=true
APP_FEEDBACK_MAX_PER_IP=5
APP_FEEDBACK_BLOCK_DURATION=60
