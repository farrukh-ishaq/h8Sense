# ===========================================
# Islamophobia Detector - Environment Configuration
# ===========================================

# ===========================================
# LLM Provider Selection
# ===========================================
# Choose either "openai" or "ollama"
LLM_PROVIDER=openai

# ===========================================
# OpenAI Configuration (if LLM_PROVIDER=openai)
# ===========================================
OPENAI_API_KEY=sk-proj-your-full-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3

# ===========================================
# Ollama Configuration (if LLM_PROVIDER=ollama)
# ===========================================
# For local Llama, Mistral, etc. via Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_0
OLLAMA_TEMPERATURE=0.3

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=jdbc:postgresql://localhost:5432/islamophobia_detector
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
JPA_DDL_AUTO=update

# ===========================================
# Server Configuration
# ===========================================
SERVER_PORT=8080

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_FILE_PATH=/var/log/islamophobia-detector/app.log

# ===========================================
# Application Settings
# ===========================================
# Maximum feedback submissions per IP
APP_FEEDBACK_MAX_PER_IP=5
# Block duration in minutes for suspicious IPs
APP_FEEDBACK_BLOCK_DURATION=60
